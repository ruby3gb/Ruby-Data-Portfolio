# =============================================================================
# Crab Food Approach Analysis
# Response variable: Time to First Approach (seconds)
# Fixed effect of interest: Treatment (C = Control, T = Treatment food pile)
# Random/grouping structure: Site (Team 1-5), Island (C = Carmen, D = Danzante),
#                            Night (Day 1 or 2 on Danzante)
# =============================================================================

# --- 1. Install / load packages ----------------------------------------------
# Run install.packages(...) lines once if you don't have these yet
# install.packages(c("readxl", "dplyr", "ggplot2", "lme4", "lmerTest", "emmeans", "car"))

library(readxl)
library(dplyr)
library(ggplot2)
library(lme4)       # mixed models
library(lmerTest)   # p-values for lmer via Satterthwaite df
library(emmeans)    # estimated marginal means / contrasts
library(car)        # Levene's test, qqPlot

# --- 2. Read data ------------------------------------------------------------
# Replace the path below with wherever you saved your file
df_raw <- read_excel("Crabs.xlsx", sheet = "Crabs", na = c("NA", ".", "#VALUE!"))

# Inspect
glimpse(df_raw)
head(df_raw)

# --- 3. Clean & prepare ------------------------------------------------------
df <- df_raw %>%
  rename(
    date         = Date,
    crab_id      = `Crab ID`,
    treatment    = Trt_Ctr,
    team         = Team,
    island       = Island,
    day          = Day,
    time_approach = `1st Approach`,
    distance_m   = `Distance (m)`,
    touch_bait   = `Touch Bait`,
    leave_bait   = `Leave Bait`,
    approach_touch = Approach_Touch,
    touch_leave  = Touch_Leave,
    comments     = comments
  ) %>%
  mutate(
    # Ensure factors
    treatment = factor(treatment, levels = c("C", "T"),
                       labels = c("Control", "Treatment")),
    island    = factor(island, levels = c("C", "D"),
                       labels = c("Carmen", "Danzante")),
    day       = factor(day),
    team      = factor(team),           # site (1–5)

    # Create a unique site label combining team and island
    site      = factor(paste0("Site", team, "_", island)),

    # Night ID: useful as a blocking variable for Danzante nights
    night_id  = factor(paste(island, day, sep = "_")),

    # time_approach must be numeric (already read as numeric if NAs handled)
    time_approach = as.numeric(time_approach)
  ) %>%
  # Drop rows where the response variable is missing
  filter(!is.na(time_approach))

cat("\nRows after removing missing response:", nrow(df), "\n")
cat("Treatment counts:\n")
print(table(df$treatment, df$island))

# --- 4. Exploratory plots ----------------------------------------------------

# 4a. Distribution by treatment
ggplot(df, aes(x = treatment, y = time_approach, fill = treatment)) +
  geom_boxplot(alpha = 0.6, outlier.shape = 16) +
  geom_jitter(width = 0.15, alpha = 0.5) +
  labs(title = "Time to First Approach by Treatment",
       x = "Food Pile", y = "Time (seconds)") +
  theme_bw()

# 4b. By treatment and island
ggplot(df, aes(x = treatment, y = time_approach, fill = treatment)) +
  geom_boxplot(alpha = 0.6) +
  geom_jitter(width = 0.12, alpha = 0.5) +
  facet_wrap(~island) +
  labs(title = "Time to First Approach by Treatment and Island",
       x = "Food Pile", y = "Time (seconds)") +
  theme_bw()

# 4c. Raw histogram — check skew
ggplot(df, aes(x = time_approach, fill = treatment)) +
  geom_histogram(bins = 30, alpha = 0.7, position = "identity") +
  labs(title = "Distribution of Approach Times",
       x = "Time (seconds)", y = "Count") +
  theme_bw()

# --- 5. Transformation check -------------------------------------------------
# Approach times are often right-skewed; log-transform is common
df <- df %>%
  mutate(log_time = log(time_approach))

# Compare raw vs log normality visually
par(mfrow = c(1, 2))
hist(df$time_approach, main = "Raw", xlab = "Seconds")
hist(df$log_time, main = "Log-transformed", xlab = "log(Seconds)")
par(mfrow = c(1, 1))

# QQ-plots
qqPlot(df$time_approach, main = "QQ: Raw")
qqPlot(df$log_time, main = "QQ: Log-transformed")

# Decision: proceed on LOG scale if it looks more normal; swap back to
# time_approach below if not. The model and emmeans back-transform
# automatically when you exponentiate.

# --- 6. Mixed-effects model --------------------------------------------------
# Fixed effect  : treatment (C vs T) — the main question
# Random effects:
#   (1 | site)      — each site (team × island combo) may have baseline
#                     differences in how active crabs are
#   (1 | night_id)  — on Danzante there are two consecutive nights;
#                     night may also vary on Carmen (here just 1 night,
#                     so effectively absorbed into site for Carmen)
#
# If the model is too complex for the data (singular fit warning),
# simplify by removing night_id first, then try (1 | island/day) instead.

model_full <- lmer(
  log_time ~ treatment + (1 | site) + (1 | night_id),
  data = df,
  REML = TRUE
)

summary(model_full)

# Check for singular fit (over-parameterised)
isSingular(model_full)

# If singular, try simpler random structure:
# model_simple <- lmer(log_time ~ treatment + (1 | site), data = df, REML = TRUE)
# summary(model_simple)

# --- 7. Model diagnostics ----------------------------------------------------
plot(model_full)                          # residuals vs fitted
qqnorm(resid(model_full)); qqline(resid(model_full))  # normality of residuals

# Levene's test on raw residuals (approximate)
df$resid <- resid(model_full)
leveneTest(resid ~ treatment, data = df)

# --- 8. Inference: treatment effect ------------------------------------------
# lmerTest gives Satterthwaite-approximated df and p-values
anova(model_full)         # F-test for treatment
coef(summary(model_full)) # t-test for treatment coefficient

# --- 9. Estimated marginal means and back-transformation --------------------
# emmeans works on the log scale and back-transforms via type = "response"
emm <- emmeans(model_full, ~ treatment, type = "response")
print(emm)           # geometric means in seconds (back-transformed)

# Pairwise contrast: Control vs Treatment
contrast(emm, method = "pairwise", adjust = "none")
# adjust = "bonferroni" or "BH" if testing multiple contrasts

# --- 10. Optional: non-parametric alternative --------------------------------
# If residuals are still non-normal after log-transform, use a
# Wilcoxon / Mann-Whitney test on raw times (ignores random structure
# but is robust):
wilcox.test(time_approach ~ treatment, data = df,
            alternative = "two.sided", exact = FALSE)

# --- 11. Summary table for reporting -----------------------------------------
df %>%
  group_by(treatment) %>%
  summarise(
    n      = n(),
    median = median(time_approach),
    mean   = mean(time_approach),
    sd     = sd(time_approach),
    min    = min(time_approach),
    max    = max(time_approach)
  ) %>%
  print()

# Also by island × treatment
df %>%
  group_by(island, day, treatment) %>%
  summarise(n = n(), median_s = median(time_approach),
            mean_s = mean(time_approach), .groups = "drop") %>%
  print()

# =============================================================================
# NOTES ON MODEL CHOICE
# =============================================================================
# 1. The LMER model above is the recommended approach because it properly
#    accounts for the non-independence of crabs from the same site/night.
#
# 2. If the model is singular (random-effect variance collapses to ~0),
#    your dataset may be too small to support two random effects. In that
#    case, use: lmer(log_time ~ treatment + (1 | site), data = df)
#    or even a simple t-test / Wilcoxon as a sensitivity check.
#
# 3. The log transformation is appropriate if approach times are right-
#    skewed (common for waiting-time data). The emmeans back-transformation
#    gives you geometric means, which are the natural summary on the
#    log scale (equivalent to medians under log-normality).
#
# 4. If you want to also test Island or Team effects, add them as fixed
#    effects: log_time ~ treatment * island + (1 | site) + (1 | night_id)
#    Be careful: Carmen has only 1 night so day is confounded with island
#    for Carmen; interpret interactions cautiously.
# =============================================================================
